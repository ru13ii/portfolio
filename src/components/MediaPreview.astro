---
import { mediaEmbedUrl } from '../lib/media.js';
import Note from './Note.astro';
const { work, large = false } = Astro.props;
const embedUrl = mediaEmbedUrl(work.mediaType, work.mediaUrl);
---
<div class:list={['media-preview', { 'media-preview--large': large }]}>
  {embedUrl ? (
    <button class="media-preview__button" type="button" data-media-embed={embedUrl}
      data-media-title={`${work.title} を再生`} aria-label={`${work.title} を再生`}>
      <span class="media-artwork">
        {work.coverUrl ? <img src={work.coverUrl} alt="" width="480" height="270" loading={large ? 'eager' : 'lazy'} />
          : <span class="media-fallback">{work.title}</span>}
        <span class="media-source">{work.mediaType === 'soundcloud' ? 'SOUNDCLOUD' : 'YOUTUBE'}</span>
        <span class="artwork-play" aria-hidden="true">▶</span>
      </span>
      <span class="staff-player">
        <span class="staff-lines" aria-hidden="true"></span>
        <span class="note-control"><Note /><span>▶ 聴く</span></span>
      </span>
    </button>
  ) : <p class="media-unavailable">再生リンクは準備中です</p>}
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-media-embed]').forEach((button) => {
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = button.dataset.mediaEmbed!;
      frame.title = button.dataset.mediaTitle!;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.className = 'media-frame';
      const slot = button.closest('.media-preview')!;
      // The player replaces only this piece; all other embeds stay unloaded.
      slot.replaceChildren(frame);
      // Focus is moved to the player so keyboard users can continue playback controls.
      frame.addEventListener('load', () => frame.focus(), { once: true });
      frame.tabIndex = 0;
    }, { once: true });
  });
</script>
