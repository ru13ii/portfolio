---
import content from '../data/content.json';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <a class="site-footer__brand" href={base}>{content.site.name}</a>
      <p>{content.site.role}</p>
    </div>
    <div class="site-footer__links">
      <a href={`${base}works/`}>Works</a>
      <a href={`${base}about/`}>About</a>
      <a href={`${base}contact/`}>Contact</a>
      <a href={content.site.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube <span class="sr-only">新しいタブで開く</span></a>
      <a href={content.site.soundcloudUrl} target="_blank" rel="noopener noreferrer">SoundCloud <span class="sr-only">新しいタブで開く</span></a>
      <a href={content.site.xUrl} target="_blank" rel="noopener noreferrer">X <span class="sr-only">新しいタブで開く</span></a>
    </div>
    <p class="site-footer__copy">© {new Date().getFullYear()} {content.site.name}</p>
  </div>
</footer>
