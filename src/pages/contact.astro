---
import SiteLayout from '../layouts/SiteLayout.astro';
import content from '../data/content.json';
const enabled = /^https:\/\//.test(content.site.formEndpoint);
---
<SiteLayout title={`Contact | ${content.site.name}`} description="RuBiiへの楽曲制作・BGM制作のご相談はこちら。">
  <div class="shell page-heading"><p class="eyebrow">04 / A NEW COMPOSITION</p><h1>Contact<span>制作のご相談</span></h1><p>{content.site.contactIntro}</p></div>
  <section class="shell contact-content" aria-label="お問い合わせ">
    <div class="contact-copy">
      <p class="eyebrow">Get in touch</p>
      <p>{content.site.contactText}</p>
      <a class="contact-x" href={content.site.xUrl} target="_blank" rel="noopener noreferrer">Xで連絡する <span aria-hidden="true">↗</span><span class="sr-only">新しいタブで開く</span></a>
    </div>
    <!-- JavaScriptが無効でも通常POSTでFormspreeへ送信できる。 -->
    <form class="contact-form" id="contact-form" action={enabled ? content.site.formEndpoint : undefined} method="POST" data-endpoint={content.site.formEndpoint}>
      {!enabled && <p class="contact-form__note">フォームは現在準備中です。ご連絡はXからお願いいたします。</p>}
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
      <div class="field">
        <label for="contact-name">お名前</label>
        <input id="contact-name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="contact-email">メールアドレス</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="contact-subject">ご相談内容</label>
        <input id="contact-subject" name="subject" required />
      </div>
      <div class="field">
        <label for="contact-message">メッセージ</label>
        <textarea id="contact-message" name="message" required></textarea>
      </div>
      <button class="button-primary contact-form__submit" type="submit" disabled={!enabled}>送信する <span aria-hidden="true">↗</span></button>
      <p class="contact-form__status" id="contact-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</SiteLayout>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const endpoint = form.dataset.endpoint;
    if (!endpoint || !endpoint.startsWith('https://')) return;
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    status.textContent = '送信しています…';
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) {
        // 利用枠や入力エラーを区別し、内容を残したまま再送できるようにする。
        const message = response.status === 429
          ? '現在フォームで送信を受け付けられません。Xからご連絡ください。'
          : '送信できませんでした。入力内容を確認するか、Xからご連絡ください。';
        throw new Error(message);
      }
      form.reset();
      status.textContent = '送信しました。ご連絡ありがとうございます。';
    } catch (error) {
      status.textContent = error instanceof Error && error.message !== 'Failed to fetch'
        ? error.message
        : '通信できませんでした。時間をおいて再度送信するか、Xからご連絡ください。';
    } finally {
      button.disabled = false;
    }
  });
</script>
