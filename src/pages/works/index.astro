---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkRow from '../../components/WorkRow.astro';
import content from '../../lib/content.js';
---
<SiteLayout title={`Works | ${content.site.name}`} description="RuBiiのオリジナル楽曲を紹介します。">
  <div class="shell page-heading"><p class="eyebrow">01 / THE COMPOSITIONS</p><h1>Works<span>作品</span></h1><p>{content.site.worksIntro}</p></div>
  <section class="shell works-content" aria-label="作品一覧">
    <div class="filter-bar" role="group" aria-label="ジャンルで絞り込む">
      <div class="genre-index"><span class="genre-index__label">GENRE INDEX</span><div class="genre-index__items"><button class="genre-index__button" type="button" data-filter="all" aria-pressed="true"><span aria-hidden="true">00</span>すべて</button>{content.genres.map((genre, index) => <button class="genre-index__button" type="button" data-filter={genre} aria-pressed="false"><span aria-hidden="true">0{index + 1}</span>{genre}</button>)}</div></div>
      <p class="filter-count" aria-live="polite"><span id="visible-count">{content.works.length}</span> works</p>
    </div>
    <div id="works-grid">{content.works.map((work, index) => <WorkRow work={work} index={index} />)}</div>
    <p class="works-empty" id="works-empty" hidden aria-live="polite">このジャンルの作品は、これから追加予定です。</p>
  </section>
</SiteLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('[data-work-genre]');
  buttons.forEach(button => button.addEventListener('click', () => {
    let visible = 0;
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    rows.forEach(row => {
      row.hidden = button.dataset.filter !== 'all' && row.dataset.workGenre !== button.dataset.filter;
      if (!row.hidden) visible++;
    });
    document.getElementById('visible-count')!.textContent = String(visible);
    document.getElementById('works-empty')!.hidden = visible !== 0;
  }));
</script>
