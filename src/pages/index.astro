---
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaPreview from '../components/MediaPreview.astro';
import content from '../data/content.json';

const base = import.meta.env.BASE_URL;
const featured = content.works.find((work) => work.featured) ?? content.works[0];
---
<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__wash" aria-hidden="true"></div>
    <div class="hero__orb" aria-hidden="true"></div>
    <div class="shell hero__inner">
      <p class="eyebrow hero__kicker">{content.site.role}</p>
      <h1 class="hero__title" id="hero-title">{content.site.name}</h1>
      <p class="hero__role">{content.site.nameJa} / {content.site.role}</p>
      <p class="hero__intro">{content.site.heroText}</p>
      <div class="hero__actions">
        <a class="button-primary" href={`${base}works/`}>作品を聴く <span aria-hidden="true">↗</span></a>
        <a class="button-plain" href={`${base}contact/`}>制作のご相談</a>
      </div>
    </div>
    <span class="hero__scroll" aria-hidden="true">SCROLL</span>
  </section>

  {featured && (
    <section class="home-section" aria-labelledby="featured-heading">
      <div class="shell">
        <div class="section-top">
          <div>
            <p class="eyebrow"><span class="section-index">01 / </span> Featured Work</p>
            <h2 class="section-heading" id="featured-heading">音楽を聴く</h2>
          </div>
          <p class="section-lead">{content.site.featuredLead}</p>
        </div>
        <div class="featured-grid">
          <MediaPreview work={featured} large />
          <div class="featured-info">
            <p class="work-overline">［ {featured.usage} ］ {featured.role}</p>
            <h3>{featured.title}</h3>
            <p class="featured-info__detail">{featured.description}</p>
            <div class="featured-info__meta">
              <span>{featured.genre}</span>
              {featured.vocal && <span>Vocal: {featured.vocal}</span>}
              {featured.year && <span>{featured.year}</span>}
            </div>
            {featured.soundcloudUrl && <p><a class="text-link" href={featured.soundcloudUrl} target="_blank" rel="noopener noreferrer">SoundCloudで聴く <span aria-hidden="true">↗</span><span class="sr-only">新しいタブで開く</span></a></p>}
            <a class="text-link" href={`${base}works/`}>すべての作品を見る <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="home-section home-news" aria-labelledby="news-heading">
    <div class="shell">
      <div class="section-top">
        <div>
          <p class="eyebrow"><span class="section-index">02 / </span> News</p>
          <h2 class="section-heading" id="news-heading">お知らせ</h2>
        </div>
        <p class="section-lead">新しい作品や活動について。</p>
      </div>
      <div class="news-list">
        {content.updates.map((update) => update.url ? (
          <a class="news-row" href={update.url} target="_blank" rel="noopener noreferrer">
            <time datetime={update.date.replaceAll('.', '-')}>{update.date}</time>
            <span>{update.text}</span>
            <span class="news-row__arrow" aria-hidden="true">↗</span>
            <span class="sr-only">新しいタブで開く</span>
          </a>
        ) : (
          <div class="news-row">
            <time datetime={update.date.replaceAll('.', '-')}>{update.date}</time>
            <span>{update.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section home-about" aria-labelledby="about-heading">
    <div class="shell home-about__inner">
      <div>
        <p class="eyebrow"><span class="section-index">03 / </span> About</p>
        <h2 class="section-heading" id="about-heading">{content.site.name}について</h2>
      </div>
      <div class="home-about__content">
        <p>{content.site.aboutText}</p>
        <a class="text-link" href={`${base}about/`}>プロフィールを見る <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="home-section home-contact" aria-labelledby="contact-heading">
    <div class="shell home-contact__inner">
      <div>
        <p class="eyebrow"><span class="section-index">04 / </span> Contact</p>
        <h2 class="section-heading" id="contact-heading">{content.site.homeContactTitle}</h2>
        <p>{content.site.homeContactText}</p>
      </div>
      <a class="button-primary" href={`${base}contact/`}>お問い合わせ <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>
