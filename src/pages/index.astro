---
import GrandPiano from '../components/GrandPiano.astro';
import MusicAir from '../components/MusicAir.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaPreview from '../components/MediaPreview.astro';
import WorkRow from '../components/WorkRow.astro';
import ContactCoda from '../components/ContactCoda.astro';
import content from '../lib/content.js';
const base = import.meta.env.BASE_URL;
const featured = content.works.find(work => work.featured) ?? content.works[0];
const selected = content.works.filter(work => work.id !== featured?.id).slice(0, 3);
---
<SiteLayout>
  <section class="music-room" aria-labelledby="hero-title">
    <div class="shell room-inner">
      <div class="grand-scene">
        <GrandPiano />
      <div class="room-intro">
        <p class="eyebrow">COMPOSER / SYNTHESIZED VOICE PRODUCER</p>
        <h1 id="hero-title">{content.site.name}</h1>
        <p class="room-message">{content.site.heroText}</p>
        <p class="room-name">{content.site.nameJa}<span aria-hidden="true"> — </span>{content.site.role}</p>
        <a class="light-link" href={`${base}about/`}>プロフィールを見る <span aria-hidden="true">↗</span></a>
        <div class="room-footer"><span>ORIGINAL MUSIC</span><span>SCROLL TO EXPLORE ↓</span></div>
      </div>
      </div>
      {featured && <div class="room-featured">
        <div class="feature-heading"><p class="eyebrow">THE FIRST NOTE</p><span>01</span></div>
        <MediaPreview work={featured} large />
        <div class="feature-caption">
          <h2>{featured.title}</h2>
          <p class="feature-description">{content.site.featuredLead}<br />{featured.description}</p>
          <p class="feature-meta">{featured.role}{featured.vocal && ` / Vocal: ${featured.vocal}`}<span>{featured.year}</span></p>
        </div>
      </div>}
    </div>
    <MusicAir />
  </section>

  <section class="shell selected-section" aria-labelledby="works-heading">
    <div class="section-heading-row">
      <div><p class="eyebrow">01 / THE COMPOSITIONS</p><h2 class="section-title" id="works-heading">Works<span>音楽を聴く</span></h2></div>
      <a class="text-link" href={`${base}works/`}>すべての作品 <span aria-hidden="true">↗</span></a>
    </div>
    {selected.map((work, index) => <WorkRow work={work} index={index + 1} heading="h3" />)}
    {!selected.length && <p class="section-intro">代表曲から、RuBiiの音楽をお楽しみください。</p>}
  </section>

  <section class="about-sheet-section" aria-labelledby="home-about-heading">
    <div class="shell about-sheet">
      <div class="sheet-portrait">
        <p class="eyebrow">02 / BEHIND THE NOTES</p>
        <img src={`${base}rubii-icon.png`} alt="るびぃのアイコン" width="400" height="400" loading="lazy" />
        <span class="portrait-signature">{content.site.name}<span>{content.site.nameJa}</span></span>
      </div>
      <div class="sheet-copy">
        <p class="eyebrow">ABOUT ME</p>
        <h2 id="home-about-heading">{content.site.aboutTitle}</h2>
        <p>{content.site.aboutText}</p>
        <a class="text-link" href={`${base}about/`}>{content.site.name}について <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="shell news-section" aria-labelledby="news-heading">
    <div class="section-heading-row"><div><p class="eyebrow">03 / RECENT NOTES</p><h2 class="section-title" id="news-heading">Journal<span>お知らせ</span></h2></div></div>
    <div class="news-list">
      {content.updates.map(update => update.url ? (
        <a class="news-row" href={update.url} target="_blank" rel="noopener noreferrer"><time datetime={update.date.replaceAll('.', '-')}>{update.date}</time><span>{update.text}</span><span aria-hidden="true">↗</span><span class="sr-only">新しいタブで開く</span></a>
      ) : <div class="news-row"><time datetime={update.date.replaceAll('.', '-')}>{update.date}</time><span>{update.text}</span></div>)}
    </div>
  </section>
  <ContactCoda />
</SiteLayout>
